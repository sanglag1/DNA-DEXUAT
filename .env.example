# Cat Sat IEA - Production Environment Variables
# Copy this file to .env and fill in the values

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=your-domain.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# ERP integration (api/views.py::api_de_xuat_propose) - ERP BE gửi header
# "Authorization: Bearer <ERP_API_KEY>", phải khớp giá trị này
ERP_API_KEY=change-me-to-a-random-secret

# PostgreSQL
DB_NAME=catsat
DB_USER=catsat
DB_PASSWORD=change-me-strong-password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
